<div class="dashboard-container">
    <aside class="sidebar">
        <div class="sidebar-header">
            <span class="sidebar-logo-section">
                <img src="" class="sidebar-logo">
                <span class="brand-name">DeepFocus Workflow</span>
            </span>
            <span class="sidebar-toggle">
                <i class="fa-solid fa-bars"></i>
            </span>
        </div>


        <nav class="nav-menu">
            <div class="nav-group">
                <a href="#" class="nav-item">
                    <i class="fa-solid fa-house"></i>
                    Home
                </a>
                <a href="/projects" class="nav-item">
                    <i class="fa-solid fa-cube"></i>
                    Projects
                </a>
            </div>

            <div class="nav-group bottom-nav">
                <a href="/calendar" class="nav-item active">
                    <i class="fa-solid fa-calendar"></i>
                    Calendar
                </a>
                <a href="#" class="nav-item">
                    <i class="fa-solid fa-chart-simple"></i>
                    Analytics
                </a>
                <a href="#" class="nav-item">
                    <i class="fa-solid fa-gear"></i>
                    Settings
                </a>
            </div>
        </nav>
    </aside>

    <main class="main-content">
        <header class="content-header dashboard-header">
            <div class="header-titles">
                <h1>Calendar</h1>
                <p>Choose which calendars to display and use for your daily energy forecast.</p>
            </div>

            <div class="header-actions"> <!-- profile actions? -->
                <img src="https://i.pravatar.cc/150?u=dfw" class="avatar">
            </div>
        </header>

        <section class="dashboard-grid">

            <!-- LEFT: Calendar Sources -->
            <div class="card">
                <h3>Calendar Sources</h3>
                <p class="card-subtext">
                    Select which calendars to include in your daily schedule.
                </p>

                <form action="/calendar/update-selection" method="POST">
                    <div class="calendar-list">
                        {{#each calendars}}
                            <label class="calendar-item">
                                <input 
                                    type="checkbox" 
                                    name="calendarIds" 
                                    class="hidden-checkbox"
                                    value="{{this.id}}" 
                                    {{#if this.selected}}checked{{/if}}
                                >

                                <span class="custom-checkbox" style="--cal-color: {{this.backgroundColor}}">
                                    <i class="fa-solid fa-check"></i>
                                </span>
                                <span class="calendar-label">
                                    {{this.summary}}
                                </span>
                            </label>
                        {{/each}}
                    </div>

                    <button type="submit" class="save-btn">Apply Selection</button>
                </form>
            </div>

            <!-- CENTER: Placeholder (Social Battery later) -->
            <div class="card">
                <h3>Social Battery Forecast</h3>
                <div class="placeholder">
                    <p>Coming soon</p>
                </div>
            </div>

            <!-- RIGHT: Placeholder -->
            <div class="card">
                <h3>How it works</h3>
                <p class="card-subtext">
                    Your schedule is built from selected calendars and ordered chronologically.
                </p>
            </div>

        </section>


        <!-- TODAY'S SCHEDULE -->
        <section class="schedule-card">

            <div class="schedule-header">
                <h3>Today's Schedule</h3>

                <!-- moved date nav here -->
                <div class="date-nav">
                    <button class="btn-outline">Today</button>
                    <button class="btn-outline"><i class="fa-solid fa-chevron-left"></i></button>
                    <button class="btn-outline"><i class="fa-solid fa-chevron-right"></i></button>
                </div>
            </div>

            <div class="schedule-list">
                {{#each events}}
                    <div class="schedule-item">
                        <div class="time">
                            {{this.startTime}}
                        </div>

                        <div class="event">
                            <span 
                                class="event-dot" 
                                style="background-color: {{this.color}}"
                            ></span>

                            <div>
                                <div class="event-title">{{this.summary}}</div>
                                <div class="event-duration">{{this.duration}} min</div>
                            </div>
                        </div>
                    </div>
                {{/each}}
            </div>

        </section>
    </main>
</div>

<script src="/js/calendar-dropdown.js"></script>