<div class="dashboard-container">
    <aside class="sidebar">
        <div class="sidebar-header">
            <span class="sidebar-logo-section">
                <img src="" class="sidebar-logo">
                <span class="brand-name">DeepFocus Workflow</span>
            </span>
            <span class="sidebar-toggle">
                <i class="fa-solid fa-bars"></i>
            </span>
        </div>




        <nav class="nav-menu">
            {{#if project}}

            <div class="nav-group project-nav">
                <a href="/projects" class="nav-item">
                    <i class="fa-solid fa-arrow-left"></i>
                    Projects
                </a>
                <h3>{{project.projectName}}</h3>
            </div>

            <div class="nav-group">
                <a href="/dash" class="nav-item">
                    <i class="fa-solid fa-gauge"></i>
                    Dashboard
                </a>
                <a href="/brief" class="nav-item">
                    <i class="fa-solid fa-bullseye"></i>
                    Mission Brief
                </a>

                <a href="/focus" class="nav-item">
                    <i class="fa-solid fa-stopwatch"></i>
                    Focus Timer
                </a>

                <a href="/notes" class="nav-item">
                    <i class="fa-regular fa-note-sticky"></i>
                    Notes and Links
                </a>
            </div>

            {{else}}

            <div class="nav-group">
                <a href="/projects" class="nav-item">
                    <i class="fa-solid fa-cube"></i>
                    Projects
                </a>
            </div>

            {{/if}}

            <div class="nav-group bottom-nav">
                <a href="/calendar" class="nav-item active">
                    <i class="fa-solid fa-calendar"></i>
                    Calendar
                </a>
                <a href="/analytics" class="nav-item">
                    <i class="fa-solid fa-chart-simple"></i>
                    Analytics
                </a>
                <a href="/settings" class="nav-item">
                    <i class="fa-solid fa-gear"></i>
                    Settings
                </a>
            </div>
        </nav>
    </aside>

    <main class="main-content">
        <header class="content-header dashboard-header">
            <div class="header-titles">
                <h1>Calendar</h1>
                <p>Choose which calendars to display and use for your daily energy forecast.</p>
            </div>

            <div class="header-actions profile-dropdown-container">
                <img src="{{user.displayImage}}" class="avatar" onclick="toggleProfileDropdown()" referrerPolicy="no-referrer">

                <div id="profile-dropdown" class="dropdown-content">
                    <div class="dropdown-info">
                        <span class="user-name">{{user.displayName}}</span>
                        <span class="user-email">{{user.email}}</span>
                    </div>

                    <a href="/auth/logout" class="logout-link">
                        <i class="fa-solid fa-right-from-bracket"></i> Logout
                    </a>
                </div>

            </div>
        </header>

        <section class="dashboard-grid">

            <!-- CALENDARS -->
            <div class="card">
                <h3>Calendars</h3>
                <p class="card-subtext">
                    Select which calendars to include in your daily schedule.
                </p>

                <form action="/calendar/update-selection" method="POST">
                    <div class="calendar-list">
                        {{#each calendars}}
                            <label class="calendar-item">
                                <input 
                                    type="checkbox" 
                                    name="calendarIds" 
                                    class="hidden-checkbox"
                                    value="{{this.id}}" 
                                    {{#if this.selected}}checked{{/if}}
                                >

                                <span class="custom-checkbox" style="--cal-color: {{this.backgroundColor}}">
                                    <i class="fa-solid fa-check"></i>
                                </span>
                                <span class="calendar-label">
                                    {{this.summary}}
                                </span>
                            </label>
                        {{/each}}
                    </div>

                    <button type="submit" class="save-btn">Apply Selection</button>
                </form>
            </div>

            <!-- ENERGY FORECAST -->
            <div class="card">
                <h3>Energy Forecast</h3>

                <div class="forecast-content-minimal">
                    <div class="battery-percent-display">
                        <span class="percent-num {{#if isLowEnergy}}low-energy-text{{/if}}">{{batteryLevel}}%</span>
                        <span class="percent-label">capacity</span>
                    </div>

                    <div class="forecast-text-minimal">
                        <h4 class="{{#if isLowEnergy}}low-energy-text{{/if}}">{{energyStatus}}</h4>
                        <p>{{energyAdvice}}</p>
                    </div>
                </div>

                <div class="forecast-badge">
                    <i class="fa-solid fa-battery-half"></i> Forecast based on selected calendars
                </div>
            </div>

        </section>


        <!-- TODAY'S SCHEDULE -->
        <section class="schedule-card">

            <div class="schedule-header">
                <h3>Today's Schedule</h3>

                <div class="date-nav">
                    <button class="btn-outline">Today</button>
                    <button class="btn-outline"><i class="fa-solid fa-chevron-left"></i></button>
                    <button class="btn-outline"><i class="fa-solid fa-chevron-right"></i></button>
                </div>
            </div>

            <div class="schedule-list">
                {{#each events}}
                    <div class="schedule-item">
                        <div class="time">
                            {{this.startTime}} - {{this.endTime}}
                        </div>

                        <div class="event">
                            <span 
                                class="event-dot" 
                                style="background-color: {{this.color}}"
                            ></span>
                            <div class="event-title">{{this.summary}}</div>

                            <div class="event-duration">{{this.duration}} min</div>
                        </div>
                    </div>
                {{/each}}
            </div>

        </section>
    </main>
</div>
