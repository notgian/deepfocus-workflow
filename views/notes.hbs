<div class="dashboard-container">
    <span class="sidebar-open sidebar-toggle" onclick="openSidebar()">
        <i class="fa-solid fa-arrow-right"></i>
    </span>

    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <span class="sidebar-logo-section">
                <img src="https://ik.imagekit.io/2hbvvnmce/dfw-logo.png" class="sidebar-logo">
                <span class="brand-name">DeepFocus Workflow</span>
            </span>
            <span class="sidebar-toggle" onclick="closeSidebar()">
                <i class="fa-solid fa-bars"></i>
            </span>
        </div>

        <nav class="nav-menu">
            <div class="nav-group project-nav">
                <a href="/projects" class="nav-item">
                    <i class="fa-solid fa-arrow-left"></i>
                    Projects
                </a>
                <h3>{{project.projectName}}</h3>
            </div>

            <div class="nav-group">
                <a href="/dash" class="nav-item">
                    <i class="fa-solid fa-gauge"></i>
                    Dashboard
                </a>
                <a href="/brief" class="nav-item">
                    <i class="fa-solid fa-bullseye"></i>
                    Mission Brief
                </a>

                <a href="/focus" class="nav-item">
                    <i class="fa-solid fa-stopwatch"></i>
                    Focus Timer
                </a>

                <a href="/notes" class="nav-item active">
                    <i class="fa-regular fa-note-sticky"></i>
                    Notes and Links
                </a>
            </div>

            <div class="nav-group bottom-nav">
                <a href="/calendar" class="nav-item">
                    <i class="fa-regular fa-calendar"></i>
                    Calendar
                </a>
            </div>
        </nav>
    </aside>

    <main class="main-content">
        <header class="content-header">
            <div class="header-titles">
                <h1>Notes</h1>
                <p>Leave yourself a reminder or two.</p>
            </div>
            <div class="header-actions profile-dropdown-container">
                <img src="{{user.displayImage}}" class="avatar" onclick="toggleProfileDropdown()" referrerPolicy="no-referrer">

                <div id="profile-dropdown" class="dropdown-content">
                    <div class="dropdown-info">
                        <span class="user-name">{{user.displayName}}</span>
                        <span class="user-email">{{user.email}}</span>
                    </div>
                    
                    <a href="/auth/logout" class="logout-link">
                        <i class="fa-solid fa-right-from-bracket"></i> Logout
                    </a>
                </div>

            </div>
        </header>

        <div class="content-body notes-container">
            <div class="notes-sidebar" data-active-note="">
                <span class="new-note-button note-sidebar-item" onclick="createNote()">
                   <i class="fa-solid fa-pen-clip"></i> Create note
                </span>
                <span class="note-sidebar-item note-item">
                   Note 1
                </span>
                <span class="note-sidebar-item note-item active">
                   Note Name
                </span>
                <span class="note-sidebar-item note-item">
                   Note 3
                </span>
                <span class="note-sidebar-item note-item">
                   Note 4
                </span>

            </div>

            <div class="notes-area">
                <span class="notes-area-active">
                    <span class="notes-area-header">
                        <input class="notes-title" value="Note Name" placeholder="Title"/>
                        <span class="notes-actions">
                            <span class="delete-note" onclick="deleteNote()">
                                <i class="fa-solid fa-trash-can"></i>
                            </span>
                        </span>
                    </span>
                    <textarea class="notes-textarea" placeholder="Type your notes here...">Notes content here</textarea>
                </span>

                <span class="notes-area-inactive">
                    <p>No note selected.</p>
                </span>
            </div>
        </div>
    </main>
</div>
