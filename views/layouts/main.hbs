<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title> {{ title }} </title>
        {{#each css}}
            <link href="{{this}}" rel="stylesheet">
        {{/each}}
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
        <link href="/css/styles.css" rel="stylesheet">
        <link rel="icon" href="https://ik.imagekit.io/2hbvvnmce/favicon.ico" type="image/x-icon">
        <script src="https://kit.fontawesome.com/6c93d5a3f5.js" crossorigin="anonymous"></script>
        <script defer src="/js/profile-dropdown.js"></script>

        {{#each js}}
            <script defer src="{{this}}"></script>
        {{/each}}
    </head>
    <body>
        {{{ body }}}
    </body>
</html>

