<div class="dashboard-container">
    <span class="sidebar-open sidebar-toggle" onclick="openSidebar()">
        <i class="fa-solid fa-arrow-right"></i>
    </span>

    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <span class="sidebar-logo-section">
                <img src="" class="sidebar-logo">
                <span class="brand-name">DeepFocus Workflow</span>
            </span>
            <span class="sidebar-toggle" onclick="closeSidebar()">
                <i class="fa-solid fa-bars"></i>
            </span>
        </div>

        <nav class="nav-menu">
            <div class="nav-group project-nav">
                <a href="/projects" class="nav-item">
                    <i class="fa-solid fa-arrow-left"></i>
                    Projects
                </a>
                <h3>{{project.projectName}}</h3>
            </div>

            <div class="nav-group">
                <a href="/dash" class="nav-item">
                    <i class="fa-solid fa-gauge"></i>
                    Dashboard
                </a>
                <a href="/brief" class="nav-item">
                    <i class="fa-solid fa-bullseye"></i>
                    Mission Brief
                </a>

                <a href="/focus" class="nav-item active">
                    <i class="fa-solid fa-stopwatch"></i>
                    Focus Timer
                </a>

                <a href="/notes" class="nav-item">
                    <i class="fa-regular fa-note-sticky"></i>
                    Notes and Links
                </a>
            </div>

            <div class="nav-group bottom-nav">
                <a href="/calendar" class="nav-item">
                    <i class="fa-regular fa-calendar"></i>
                    Calendar
                </a>
                <a href="/analytics" class="nav-item">
                    <i class="fa-solid fa-chart-simple"></i>
                    Analytics
                </a>
                <a href="/settings" class="nav-item">
                    <i class="fa-solid fa-gear"></i>
                    Settings
                </a>
            </div>
        </nav>
    </aside>

    <main class="main-content">
        <header class="content-header">
            <div class="header-titles">
                <h1>Focus Session</h1>
                <p>Eliminate distractions. Do your best deep work.</p>
            </div>
            <div class="header-actions profile-dropdown-container">
                <img src="{{user.displayImage}}" class="avatar" onclick="toggleProfileDropdown()" referrerPolicy="no-referrer">

                <div id="profile-dropdown" class="dropdown-content">
                    <div class="dropdown-info">
                        <span class="user-name">{{user.displayName}}</span>
                        <span class="user-email">{{user.email}}</span>
                    </div>

                    <a href="/auth/logout" class="logout-link">
                        <i class="fa-solid fa-right-from-bracket"></i> Logout
                    </a>
                </div>

            </div>
        </header>

        <div class="focus-grid">
            <section class="card timer-card">
                <div class="card-header">
                    <span class="icon">
                        <i class="fa-solid fa-stopwatch"></i>
                    </span> 
                    <h3>Focus Timer</h3>
                    <span class="info-icon">
                        <i class="fa-solid fa-circle-info"></i>
                    </span>
                </div>

                <div class="session-selector">
                    <button class="set-time-20 active" onclick="setTimer(20)">20 min</button>
                    <button class="set-time-30" onclick="setTimer(30)">30 min</button>
                    <button class="set-time-50" onclick="setTimer(50)">50 min</button>
                </div>

                <div class="timer-display" data-selected-time="20" data-timer-seconds="0" data-timer-minutes="20" data-timer-paused=false>
                    <div class="progress-ring">
                        <div class="time-text">
                            <h2>20:00</h2>
                            <p>Micro Sprint</p>
                        </div>
                    </div>
                </div>

                <div class="timer-controls" data-timer='start'>
                    <button class="timer-buttons btn-primary timer-start-stop" onclick="timerStartStop()">
                        <i class="fa-solid fa-play"></i>
                        Start
                    </button>
                    <button class="timer-buttons btn-outline timer-pause" onclick="toggleTimerPause()">
                        <i class="fa-solid fa-pause"></i>
                        Pause
                    </button>
                </div>
            </section>

            <div class="sidebar-column">
                <section class="card brain-dump">
                    <div class="card-header">
                        <span class="icon">
                            <i class="fa-solid fa-brain"></i>
                        </span> 
                        <h3>Brain Dump</h3>
                    </div>
                    <p class="subtext">Get your thoughts out so you can stay in focus.</p>
                    <textarea class="brain-dump-textarea" placeholder="What did you finish? What blocked you? What should future you continue?"></textarea>
                    <button class="btn-primary full-width" onclick="saveDump()">
                        <i class="fa-solid fa-floppy-disk"></i>
                        Save Brain Dump
                    </button>
                </section>

                <div class="card focus-tip">
                    <span class="icon">✨</span>
                    <div>
                        <strong>Focus Tip</strong>
                        <p>Protect your focus like your future depends on it. Because it does.</p>
                    </div>
                </div>
            </div>
        </div>

    </main>

</div>
