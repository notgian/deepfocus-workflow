<div class="dashboard-container">
    <span class="sidebar-open sidebar-toggle" onclick="openSidebar()">
        <i class="fa-solid fa-arrow-right"></i>
    </span>

    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <span class="sidebar-logo-section">
                <img src="" class="sidebar-logo">
                <span class="brand-name">DeepFocus Workflow</span>
            </span>
            <span class="sidebar-toggle" onclick="closeSidebar()">
                <i class="fa-solid fa-bars"></i>
            </span>
        </div>

        <nav class="nav-menu">
            <div class="nav-group project-nav">
                <a href="/projects" class="nav-item">
                    <i class="fa-solid fa-arrow-left"></i>
                    Projects
                </a>
                <h3>{{project.projectName}}</h3>
            </div>

            <div class="nav-group">
                <a href="/dash" class="nav-item">
                    <i class="fa-solid fa-gauge"></i>
                    Dashboard
                </a>
                <a href="/brief" class="nav-item active">
                    <i class="fa-solid fa-bullseye"></i>
                    Mission Brief
                </a>

                <a href="/focus" class="nav-item">
                    <i class="fa-solid fa-stopwatch"></i>
                    Focus Timer
                </a>

                <a href="/notes" class="nav-item">
                    <i class="fa-regular fa-note-sticky"></i>
                    Notes and Links
                </a>
            </div>

            <div class="nav-group bottom-nav">
                <a href="/calendar" class="nav-item">
                    <i class="fa-regular fa-calendar"></i>
                    Calendar
                </a>
                <a href="/analytics" class="nav-item">
                    <i class="fa-solid fa-chart-simple"></i>
                    Analytics
                </a>
                <a href="/settings" class="nav-item">
                    <i class="fa-solid fa-gear"></i>
                    Settings
                </a>
            </div>
        </nav>
    </aside>

    <main class="main-content">
        <header class="content-header">
            <div class="header-titles">
                <h1>Mission Brief</h1>
                <p>Clarity on the mission. Focus on what matters next.</p>
            </div>
            <div class="header-actions">
                <img src="{{user.displayImage}}" class="avatar" referrerPolicy="no-referrer">
            </div>
        </header>

        <section class="card project-banner">
            <div class="icon-box purple">
                <i class="fa-solid fa-cube"></i>
            </div>
            <div class="banner-content">
                <span class="label">Project</span>
                <h2>DeepFocus Workflow — UI/UX Concept</h2>
            </div>
        </section>

        <section class="card card-banner">
            <div class="icon-box blue">
                <i class="fa-solid fa-clock-rotate-left"></i>
            </div>

            <span class="card-text-right">
                <h2>Where You Left Off</h2>
                <div class="status-text">
                    <p>You were finalizing UI/UX design pages for the dashboard.</p>
                    <p>You defined key widgets, layout hierarchy, and user flows.</p>
                    <p class="highlight">Next up: prepare the dashboard structure and component map.</p>
                </div>
            </span>

        </section>

        <section class="card task-section card-banner">
            <div class="icon-box blue">
                <i class="fa-solid fa-calendar"></i>
            </div>
            <span class="card-text-right">
                <h2>Today's Schedule</h2>
                <div class="schedule-list">
                    {{#if events}}
                        {{#each events}}
                            <div class="schedule-item">
                                <div class="time">
                                    {{this.startTime}} - {{this.endTime}}
                                </div>

                                <div class="event">
                                    <span 
                                        class="event-dot" 
                                        style="background-color: {{this.color}}"
                                    ></span>
                                    <div class="event-title">{{this.summary}}</div>

                                    <div class="event-duration">{{this.duration}} min</div>
                                </div>
                            </div>
                        {{/each}}
                    {{else}}
                    <span class="schedule-none"> No events for today. </span>
                    {{/if}}
                </div>
            </span>
        </section>

        <button class="btn-start-session" onclick="window.location.href='/focus'">
            <span>▶</span> Start Focus Session
        </button>
    </main>
</div>


