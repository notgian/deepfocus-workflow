<div class="dashboard-container">
    <span class="sidebar-open sidebar-toggle" onclick="openSidebar()">
        <i class="fa-solid fa-arrow-right"></i>
    </span>

    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <span class="sidebar-logo-section">
                <img src="" class="sidebar-logo">
                <span class="brand-name">DeepFocus Workflow</span>
            </span>
            <span class="sidebar-toggle" onclick="closeSidebar()">
                <i class="fa-solid fa-bars"></i>
            </span>
        </div>

        <nav class="nav-menu">
            <div class="nav-group project-nav">
                <a href="/projects" class="nav-item">
                    <i class="fa-solid fa-arrow-left"></i>
                    Projects
                </a>
                <h3>{{project.projectName}}</h3>
            </div>

            <div class="nav-group">
                <a href="/dash" class="nav-item active">
                    <i class="fa-solid fa-gauge"></i>
                    Dashboard
                </a>
                <a href="/brief" class="nav-item">
                    <i class="fa-solid fa-bullseye"></i>
                    Mission Brief
                </a>

                <a href="/focus" class="nav-item">
                    <i class="fa-solid fa-stopwatch"></i>
                    Focus Timer
                </a>

                <a href="/notes" class="nav-item">
                    <i class="fa-regular fa-note-sticky"></i>
                    Notes and Links
                </a>
            </div>

            <div class="nav-group bottom-nav">
                <a href="/calendar" class="nav-item">
                    <i class="fa-regular fa-calendar"></i>
                    Calendar
                </a>
                <a href="/analytics" class="nav-item">
                    <i class="fa-solid fa-chart-simple"></i>
                    Analytics
                </a>
                <a href="/settings" class="nav-item">
                    <i class="fa-solid fa-gear"></i>
                    Settings
                </a>
            </div>
        </nav>
    </aside>

    <main class="main-content">
        <header class="content-header">
            <div class="header-titles">
                <h1>Good Morning, {{user.displayName}} 👋</h1>
                <p>Let's make today your most focused day.</p>
            </div>
            <div class="header-actions profile-dropdown-container">
                <img src="{{user.displayImage}}" class="avatar" onclick="toggleProfileDropdown()" referrerPolicy="no-referrer">

                <div id="profile-dropdown" class="dropdown-content">
                    <div class="dropdown-info">
                        <span class="user-name">{{user.displayName}}</span>
                        <span class="user-email">{{user.email}}</span>
                    </div>
                    
                    <a href="/auth/logout" class="logout-link">
                        <i class="fa-solid fa-right-from-bracket"></i> Logout
                    </a>
                </div>

            </div>
        </header>

        <section class="dashboard-grid">         

            <!-- ENERGY FORECAST -->
            <div class="card">
                <h3>Energy Forecast</h3>

                <div class="forecast-content-minimal">
                    <div class="battery-percent-display">
                        <span class="percent-num {{#if isLowEnergy}}low-energy-text{{/if}}">{{batteryLevel}}%</span>
                        <span class="percent-label">capacity</span>
                    </div>

                    <div class="forecast-text-minimal">
                        <h4 class="{{#if isLowEnergy}}low-energy-text{{/if}}">{{energyStatus}}</h4>
                    </div>
                </div>

                <div class="forecast-badge">
                    <i class="fa-solid fa-battery-half"></i> Forecast based on selected calendars
                </div>
            </div>

            <!-- Today's Schedule -->
            <div class="card">
                <div class="schedule-header">
                    <h3>Today's Schedule</h3>
                    <a href="/calendar" class="view-calendar-link">Full Calendar <i class="fa-solid fa-arrow-right"></i></a>
                </div>

                <div class="schedule-list">
                    {{#each events}}
                        <div class="schedule-item">
                            <div class="time">
                                {{this.startTime}}
                            </div>

                            <div class="event">
                                <div class="event-title">{{this.summary}}</div>
                                <div class="event-duration">{{this.duration}} min</div>
                            </div>
                        </div>
                    {{/each}}
                </div>
            </div>

            <!-- Recommended focus sprint -->
            <div class="card sprint-card">
                <h3>Recommended Sprint</h3>
                
                <div class="sprint-content">
                    <div class="sprint-icon">
                        {{#if isLowEnergy}}
                            <i class="fa-solid fa-battery-quarter low-energy-text"></i>
                        {{else}}
                            <i class="fa-solid fa-bolt-lightning"></i>
                        {{/if}}
                    </div>

                    <p class="sprint-time">{{timerPreview}}</p>

                    <div class="sprint-actions">
                        <a href="/focus/{{project._id}}" class="btn-focus">
                            <i class="fa-solid fa-play"></i> Start Focus Session
                        </a>
                    </div>
                </div>
            </div>

        </section>

        <section class="dashboard-bottom-row">

            <div class="card ai-brief-card card-horizontal">
                <div class="icon-box blue">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                </div>
                <div class="card-text-right">
                    <h3>Mission Brief</h3>
                    <div class="status-text">
                        {{#if brief}}
                            <p class="brief-text">{{brief}}</p>
                        {{else}}
                            <p class="brief-text">Generating brief summary...</p>
                        {{/if}}
                    </div>
                </div>
            </div>

            <div class="card notes-card card-horizontal">
                <div class="icon-box blue">
                    <i class="fa-solid fa-pen-clip"></i>
                </div>
                <div class="card-text-right">
                    <h3>Notes</h3>
                    <div class="status-text">
                        <p class="brief-text">Your project notes will appear here.</p>
                    </div>
                </div>
            </div>

        </section>
        

    </main>

</div>
