<div class="dashboard-container">
    <span class="sidebar-open sidebar-toggle" onclick="openSidebar()">
        <i class="fa-solid fa-arrow-right"></i>
    </span>

    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <span class="sidebar-logo-section">
                <img src="" class="sidebar-logo">
                <span class="brand-name">DeepFocus Workflow</span>
            </span>
            <span class="sidebar-toggle" onclick="closeSidebar()">
                <i class="fa-solid fa-bars"></i>
            </span>
        </div>

        <nav class="nav-menu">
            <div class="nav-group">
                <a href="/projects" class="nav-item active">
                    <i class="fa-solid fa-cube"></i>
                    Projects
                </a>
            </div>

            <div class="nav-group bottom-nav">
                <a href="/calendar" class="nav-item">
                    <i class="fa-regular fa-calendar"></i>
                    Calendar
                </a>
                <a href="/analytics" class="nav-item">
                    <i class="fa-solid fa-chart-simple"></i>
                    Analytics
                </a>
                <a href="/settings" class="nav-item">
                    <i class="fa-solid fa-gear"></i>
                    Settings
                </a>
            </div>
        </nav>
    </aside>

    <main class="main-content">
        <header class="content-header">
            <div class="header-titles">
                <h1>Projects</h1>
                <p>Choose what you want to focus on today.</p>
            </div>
            <div class="header-actions profile-dropdown-container">
                <img src="{{user.displayImage}}" class="avatar" onclick="toggleProfileDropdown()" referrerPolicy="no-referrer">

                <div id="profile-dropdown" class="dropdown-content">
                    <div class="dropdown-info">
                        <span class="user-name">{{user.displayName}}</span>
                        <span class="user-email">{{user.email}}</span>
                    </div>
                    
                    <a href="/auth/logout" class="logout-link">
                        <i class="fa-solid fa-right-from-bracket"></i> Logout
                    </a>
                </div>

            </div>
        </header>

        <div class="action-bar">
            <button class="new-project-btn" onclick="openProjectModal()">
                <i class="fa-solid fa-plus"></i>
                New Project
            </button>
        </div>

        <section class="project-grid">
            {{#if projects}}
                {{#each projects}}
                    <div class="project-card">
                        <div class="card-header">
                            <div class="project-icon-box purple-bg">
                                <i class="fa-solid fa-cube"></i>
                            </div>
                            <div class="project-info">
                                <h3>{{this.projectName}}</h3>
                                <p>{{this.projectDesc}}</p>
                            </div>
                        </div>
                        <button class="btn-outline" data-pid="{{this._id}}" onclick="openProject(this)">
                            <i class="fa-solid fa-play"></i> Open Project
                        </button>
                    </div>
                {{/each}}
            {{else}}
                No projects...
            {{/if}}

            <!-- Additional cards follow same structure -->
        </section>
    </main>

    <span class="project-create-modal">
        <div class="project-create-container">
            <span class="project-create-header">
                <h2>New Project</h2>
                <span class="project-create-close" onclick="closeProjectModal()">
                    <i class="fa-solid fa-xmark"></i>
                </span>
            </span>

            <form id="project-create-form" class="project-create-form" method="POST" action="/projects">
                <span class="input-group">
                    <p>Project Name<p>
                    <input type="text" name="projectName" placeholder="Enter project name..."/>
                </span>

                <span class="input-group">
                    <p>Project Description</p>
                    <textarea name="projectDesc" placeholder="Enter project description..."></textarea>
                </span>

                <button class="project-create-button">
                    Create Project
                </button>
            </form>

        </div>

    </span>
</div>
